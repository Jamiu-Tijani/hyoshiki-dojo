{
  "name": "hyoshiki-dojo",
  "private": true,
  "type": "module",
  "scripts": {
    "kb": "node tools/build-kb.mjs",
    "kb:check": "node tools/build-kb.mjs --check",
    "fonts": "node tools/fonts.mjs",
    "dev": "node tools/fonts.mjs && vite -c vite.app.config.ts",
    "typecheck": "tsc --noEmit",
    "build:engine": "vite build",
    "build:app": "node tools/fonts.mjs && vite build -c vite.app.config.ts",
    "build": "node tools/build-kb.mjs --check && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && npm run build:app && node tools/assemble.mjs",
    "test:logic": "node --test \"tests/logic/*.test.mjs\"",
    "test:app": "node --test \"tests/app/*.test.mjs\"",
    "golden": "python3 tools/golden-old.py"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans-jp": "^0.4.4",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "subset-font": "^2.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
